# syntax=docker/dockerfile:1
#
# Seek → Floppy MCP server, as a long-lived HTTP service for a compose stack.
# Defaults to MCP_TRANSPORT=http on :8110 (POST /mcp). See mcp/README.md.

FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
RUN npm run build

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
# Run as an HTTP service by default — the point of putting it in compose.
ENV MCP_TRANSPORT=http
ENV PORT=8110

# Unlike the SvelteKit app (adapter-node bundles its deps), this server loads its
# dependencies at runtime, so the runtime image needs the production node_modules.
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/dist ./dist

USER node
EXPOSE 8110
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
	CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8110)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "dist/index.js"]
