# Seek — copy to .env and fill in. .env is gitignored; never commit it.

# Floppy base URL.
#   Local dev (from your Mac, over the LAN):  http://floppy.example.com:8007
#   In compose (on floppy-net, by container): http://floppy:8000
FLOPPY_URL=http://floppy.example.com:8007

# Floppy → Settings → Integrations → API Token
FLOPPY_TOKEN=

# Floppy → Calendar page → the token in the .ics feed URL.
# Not needed until step 6 (Upcoming); leave blank for now.
FLOPPY_CALENDAR_TOKEN=

# themoviedb.org API key. Not needed until step 5/7; leave blank for now.
TMDB_API_KEY=

# Browser-reachable Floppy address, e.g. http://floppy.example.com:8007. Used ONLY for the
# settings link the phone opens directly — every other call is proxied
# server-side, so FLOPPY_URL may be a container name a phone cannot resolve.
# Leave blank and the link is simply not shown.
FLOPPY_PUBLIC_URL=

# Signs the login cookie. Required. openssl rand -hex 32
SEEK_SESSION_SECRET=

# Encrypts the credentials Seek stores for each person (their Floppy token,
# calendar token, BookOrbit password). Required to link accounts in Settings.
# openssl rand -hex 32 — and keep it: changing it makes stored links unreadable
# (everyone would have to re-link).
SEEK_TOKEN_KEY=

# Accounts replaced the shared passphrase. It now only unlocks first-run setup
# (/setup), proving whoever creates the owner account is whoever deployed Seek.
# Set it for any deployment reachable off the LAN.
SEEK_PASSPHRASE=

# Where the household user store lives. Defaults to $SEEK_DATA_DIR/seek.db (/data).
# SEEK_DB_PATH=

# Email (optional) — invites, password resets, address confirmation, via Resend.
# Without these, Settings → Household hands the owner the links to send instead.
# MAIL_FROM must be on a domain verified in Resend, e.g. "Seek <seek@example.com>".
RESEND_API_KEY=
MAIL_FROM=

# Books (optional) — docs/books-plan.md.
# BookOrbit: the self-hosted library. Each person links their own BookOrbit login
# in Settings; BOOKORBIT_USER/PASSWORD are only the owner's fallback.
BOOKORBIT_URL=
BOOKORBIT_USER=
BOOKORBIT_PASSWORD=
# Hardcover: book discovery (search, trending, new). A personal access token from
# hardcover.app/settings — the catalog is public, so one token serves everyone.
HARDCOVER_TOKEN=

TZ=America/New_York

# Web Push — the daily "airing today" notification. Optional; notifications are
# simply unavailable until these are set. Generate a keypair once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The PUBLIC key is sent to browsers (that's fine); keep the PRIVATE key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact URL or mailto: for the push service to reach you about your pushes.
VAPID_SUBJECT=mailto:you@example.com

# Sonarr / Radarr — "Add to Sonarr/Radarr" buttons while browsing. Optional;
# a service with no URL+key simply shows no button. The API key lives in each
# app under Settings -> General -> Security, and is only ever read server-side.
SONARR_URL=
SONARR_API_KEY=
RADARR_URL=
RADARR_API_KEY=

# Jellyfin — source of truth for the Shows/Anime split. Optional; without a
# URL+key Seek shows everything as TV (no Anime tab). The API key is read-only
# and comes from Jellyfin's Dashboard -> API Keys. JELLYFIN_URL must be
# reachable from the Seek container (a container name like http://jellyfin:8096,
# or the public URL). JELLYFIN_ANIME_LIBRARY names the anime library (default Anime).
JELLYFIN_URL=
JELLYFIN_API_KEY=
JELLYFIN_ANIME_LIBRARY=Anime
