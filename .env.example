# Seek — copy to .env for local development. .env is gitignored; never commit it.
#
# Seek needs almost no configuration. It generates its own secrets (session
# signing, the key that encrypts stored logins, Web Push keys) into
# $SEEK_DATA_DIR/secrets.json, and everything about the household's services
# is set in the app: Settings → Services (owner) and Settings → Your accounts
# (each person). First run prints a setup code to the log.

TZ=America/New_York

# Where Seek keeps its state. /data in the container; a local folder in dev.
SEEK_DATA_DIR=./data
# SEEK_DB_PATH=            # defaults to $SEEK_DATA_DIR/seek.db

# ── Optional overrides ────────────────────────────────────────────────────────
# Keep the encryption key apart from /data (a backup of /data alone then can't
# decrypt stored logins). If you set it, keep it set — it is not copied anywhere.
# SEEK_TOKEN_KEY=

# ── Upgrading from an older Seek ──────────────────────────────────────────────
# These used to be required. If present on first boot they are copied into Seek
# once — services into Settings → Services, the credentials onto the owner's
# account — and are ignored after that, so they can be deleted:
#
#   TMDB_API_KEY  BOOKORBIT_URL  HARDCOVER_TOKEN
#   SONARR_URL  SONARR_API_KEY  RADARR_URL  RADARR_API_KEY
#   RESEND_API_KEY  MAIL_FROM
#   BOOKORBIT_USER  BOOKORBIT_PASSWORD
#   SEEK_SESSION_SECRET  VAPID_PUBLIC_KEY  VAPID_PRIVATE_KEY   (copied to secrets.json)
#
# SEEK_PASSPHRASE, if still set, is the first-run setup code instead of the
# generated one.
